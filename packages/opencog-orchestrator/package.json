{
  "name": "@msinternal/botframework-webchat-opencog-orchestrator",
  "version": "0.0.0-0",
  "private": true,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "test:watch": "jest --watch",
    "precommit": "npm run precommit:eslint && npm run precommit:typecheck",
    "precommit:eslint": "eslint . --config .eslintrc.yml --ext .js,.jsx,.ts,.tsx --fix --ignore-path .gitignore --max-warnings 0 --report-unused-disable-directives",
    "precommit:typecheck": "tsc --project ./src/tsconfig.json --noEmit",
    "start": "npm run build -- --watch"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.8.3",
    "tsup": "^8.5.0"
  },
  "dependencies": {
    "rxjs": "^7.8.1"
  }
}